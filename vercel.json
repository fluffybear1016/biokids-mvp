{
  "crons": [
    {
      "path": "/api/cron/notify?slot=morning",
      "schedule": "45 10 * * *"
    },
    {
      "path": "/api/cron/notify?slot=lunch",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/notify?slot=exercise",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/notify?slot=dinner",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/notify?slot=bedtime",
      "schedule": "30 23 * * *"
    }
  ]
}
